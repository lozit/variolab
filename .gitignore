/vendor/
/node_modules/
composer.lock
package-lock.json
.DS_Store
.idea/
.vscode/
*.log

# wp-env runtime
.wp-env/

# Local test artifacts (HTML imports, sample files)
/test.html
/test-*.html

# Design reference / mockups (local-only, not committed)
/variolab-template/

# Local dev tooling — gitignored as a folder, but specific scripts are
# explicitly allowed so the repo stays reproducible.
/tools/*
!/tools/build-fonts.sh
!/tools/optimize-screenshots.sh

# Per-machine PHP language server config
/.phpactor.json

# PHPUnit
.phpunit.result.cache

# Build artifacts
/build/
/dist/

# Claude Code local overrides (personal, not committed)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# OS / editor noise
Thumbs.db
*.swp
*.swo

# Secrets — defense-in-depth (none of these files exist today, just preventive)
.env
.env.*
*.local.php
*.key
*.pem
*.p12
secrets.json

# Note: wp-tests-config.php is intentionally TRACKED (the integration-test
# bootstrap requires it and it holds only wp-env's public defaults, no real
# secret). It used to be listed above, which was misleading — a committed file
# is never actually ignored. Keep it tracked; never put a real credential in it.

# Playwright MCP browser artifacts
.playwright-mcp/
